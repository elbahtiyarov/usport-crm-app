PORT=3000

# Строка подключения к вашей базе PostgreSQL.
# Для docker-compose (сервисы db+app в одной сети) хост — "db":
DATABASE_URL=postgresql://usport:usport@db:5432/usport_crm

# Для локального запуска без Docker (Postgres на этой же машине) используйте:
# DATABASE_URL=postgresql://usport:usport@localhost:5432/usport_crm
