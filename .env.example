PORT=3000

# Строка подключения к вашей базе PostgreSQL.
# Для docker-compose (сервисы db+app в одной сети) хост — "db":
DATABASE_URL=postgresql://usport:usport@db:5432/usport_crm

# Для локального запуска без Docker (Postgres на этой же машине) используйте:
# DATABASE_URL=postgresql://usport:usport@localhost:5432/usport_crm

# --- Авторизация (логин + пароль, без отправки почты) ---
# Логин — любая строка (необязательно похожая на email). При первом
# входе с новым логином введённый пароль просто запоминается — это и
# есть регистрация. При следующих входах он проверяется как обычно.

# Секрет для подписи сессий — обязательно замените на свою случайную строку
# (например: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-secret

# Кому разрешён вход, через запятую (переменная называется *_EMAILS по
# историческим причинам, но подойдёт любой логин). Пусто = войти сможет
# кто угодно (не рекомендуется для продакшена).
ALLOWED_EMAILS=admin,manager1

# Кто из вошедших получает роль admin — видит и может редактировать/удалять
# ЛЮБЫЕ записи. Остальные (роль manager) — только свои.
ADMIN_EMAILS=admin

# --- Почта (сейчас не используется для входа — оставлено на будущее) ---
# Если позже вернёте вход по коду на почту, эти настройки уже готовы.
# Можно заполнить сразу несколько — сервер пробует по очереди.
GMAIL_USER=
GMAIL_PASS=
YANDEX_USER=
YANDEX_PASS=
MAILRU_USER=
MAILRU_PASS=
SMTP_ORDER=gmail,yandex,mailru
SMTP_FROM="USPORT CRM <no-reply@usport.kz>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Гифки в сообщениях (необязательно) ---
# Без ключа используется общий демо-ключ Giphy — работает "из коробки",
# но может тормозить под нагрузкой (он общий на весь интернет). Бесплатный
# личный ключ — на developers.giphy.com, займёт пару минут.
GIPHY_API_KEY=

